# =============================================================================
# EBE Consulting — variables d'environnement (exemple)
# Copier vers .env.local et remplir les valeurs réelles.
# =============================================================================

# --- Base de données PostgreSQL (local / Docker) ---
DATABASE_URL="postgresql://ebe:ebe_password@localhost:5432/ebe_payload"

# --- Payload CMS ---
# Générer : openssl rand -base64 32  (ou PowerShell équivalent)
PAYLOAD_SECRET="change_me_long_random_secret_key_min_32_chars"

# --- URL publique du site ---
# Local
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production (Vercel) : https://ebeconsulting.fr

# --- Revalidation ISR ---
REVALIDATION_SECRET="change_me_revalidation_secret"

# --- Compte admin Payload (seed) ---
ADMIN_EMAIL="admin@ebeconsulting.fr"
ADMIN_PASSWORD="ChangeMeStrong123!"

# =============================================================================
# Formulaire contact / demande de devis — SMTP OVH (Nodemailer)
# =============================================================================
# Compte messagerie OVH : Espace client → Web Cloud → Emails → ebeconsulting.fr
# → compte eb@ebeconsulting.fr → « Configuration » / paramètres du client mail
#
# Serveur SMTP OVH (MX Plan, Email Pro, etc.) :
#   Hôte : ssl0.ovh.net
#   Port 587 + STARTTLS (recommandé)  OU  port 465 + SSL
#
# Important OVH :
# - SMTP_USER = adresse e-mail complète (ex. eb@ebeconsulting.fr)
# - SMTP_PASS = mot de passe de la boîte mail OVH (pas le mot de passe Espace Client)
# - EMAIL_FROM doit utiliser la même adresse que SMTP_USER (sinon refus / spam)

# Boîte qui reçoit les demandes de devis / contact
EMAIL_TO="eb@ebeconsulting.fr"

# Expéditeur (identique au compte SMTP OVH)
EMAIL_FROM="EBE Consulting <eb@ebeconsulting.fr>"

# --- Option A (recommandée) : port 587 + STARTTLS ---
SMTP_HOST="ssl0.ovh.net"
SMTP_PORT="587"
SMTP_SECURE="false"

# --- Option B : port 465 + SSL (décommenter et commenter l’option A si besoin) ---
# SMTP_HOST="ssl0.ovh.net"
# SMTP_PORT="465"
# SMTP_SECURE="true"

# Identifiants du compte mail OVH
SMTP_USER="eb@ebeconsulting.fr"
SMTP_PASS="REMPLACER_PAR_MOT_DE_PASSE_BOITE_MAIL_OVH"

# Si vous utilisez Email Pro OVH, le serveur peut être proX.mail.ovh.net
# (indiqué dans l’espace client pour votre offre) :
# SMTP_HOST="pro1.mail.ovh.net"
